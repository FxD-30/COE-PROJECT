# Copied to .env by ./setup.sh. Every value has a default in docker-compose.yml,
# so this file is optional for a plain `docker compose up`.

# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432

# Database (used by both the postgres and backend containers).
# Postgres only applies these when its data volume is first created.
POSTGRES_DB=coe
POSTGRES_USER=coe
POSTGRES_PASSWORD=secret

# Laravel encryption key. ./setup.sh fills this in.
APP_KEY=

# Load demo categories, products, a test user and orders on startup (idempotent).
SEED_DEMO_DATA=true
